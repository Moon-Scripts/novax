<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Nova — Aesthetic Pack</title>

<style>
/* ===== RESET Y VARIABLES ===== */
* { margin: 0; padding: 0; box-sizing: border-box; }

:root {
    --nova: #7c5cff;
    --nova-oscuro: #5a3fd9;
    --nova-claro: #a78bfa;
    --dorado: #d4af37;
    --bg: #0a0a0f;
    --bg-2: #0f0f18;
    --bg-card: #14141f;
    --texto: #e8e8e8;
    --texto-gris: #8a8a95;
    --borde: rgba(255,255,255,0.08);
    --transicion: cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

html { scroll-behavior: smooth; }

body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--texto);
    line-height: 1.6;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar { width: 10px; }
::-webkit-scrollbar-track { background: var(--bg); }
::-webkit-scrollbar-thumb {
    background: linear-gradient(180deg, var(--nova), var(--nova-oscuro));
    border-radius: 10px;
    border: 2px solid var(--bg);
}

/* ===== NAVBAR ===== */
.navbar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 1000;
    padding: 18px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(10,10,15,0.75);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--borde);
    transition: all 0.3s var(--transicion);
}

.navbar.scrolled {
    padding: 12px 40px;
    background: rgba(10,10,15,0.95);
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    font-size: 1.3rem;
    letter-spacing: 3px;
    color: white;
    text-decoration: none;
}

.brand-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: rgba(255,255,255,0.03);
    box-shadow: 0 4px 20px rgba(124,92,255,0.5);
    flex-shrink: 0;
}

.brand-icon img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
}

.nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
}

.nav-links a {
    color: var(--texto-gris);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s;
    position: relative;
}

.nav-links a:hover { color: white; }

.nav-links a::after {
    content: '';
    position: absolute;
    bottom: -6px; left: 0;
    width: 0; height: 2px;
    background: var(--nova);
    transition: width 0.3s var(--transicion);
}

.nav-links a:hover::after { width: 100%; }

.nav-cta {
    padding: 9px 22px;
    background: linear-gradient(135deg, var(--nova), var(--nova-oscuro));
    color: white;
    border: none;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s var(--transicion);
    box-shadow: 0 4px 15px rgba(124,92,255,0.4);
}

.nav-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 25px rgba(124,92,255,0.6);
}

/* ===== HERO ===== */
.hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 120px 40px 80px;
    overflow: hidden;
}

.hero-bg {
    position: absolute;
    inset: 0;
    background: url('nova-1.jpg') center/cover no-repeat;
    filter: brightness(0.35) saturate(1.2) contrast(1.1);
    z-index: 0;
    animation: heroZoom 20s ease-in-out infinite alternate;
}

@keyframes heroZoom {
    from { transform: scale(1); }
    to { transform: scale(1.08); }
}

.hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: 
        radial-gradient(ellipse at 30% 50%, rgba(124,92,255,0.2) 0%, transparent 60%),
        linear-gradient(to bottom, rgba(10,10,15,0.4) 0%, rgba(10,10,15,0.85) 70%, var(--bg) 100%);
    z-index: 1;
}

.hero-content {
    position: relative;
    z-index: 2;
    max-width: 720px;
    animation: fadeUp 1.2s var(--transicion);
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: rgba(124,92,255,0.12);
    border: 1px solid rgba(124,92,255,0.3);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--nova-claro);
    margin-bottom: 24px;
}

.hero-badge::before {
    content: '';
    width: 6px; height: 6px;
    background: var(--nova);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--nova);
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
}

.hero h1 {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -3px;
    margin-bottom: 24px;
    background: linear-gradient(135deg, #ffffff 0%, #c4b5fd 50%, var(--nova) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero p {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    color: var(--texto-gris);
    max-width: 560px;
    margin-bottom: 40px;
    font-weight: 300;
}

.hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    border-radius: 50px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.5px;
    cursor: pointer;
    border: none;
    transition: all 0.4s var(--transicion);
}

.btn-primary {
    background: linear-gradient(135deg, var(--nova), var(--nova-oscuro));
    color: white;
    box-shadow: 0 4px 20px rgba(124,92,255,0.4);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 35px rgba(124,92,255,0.6);
}

.btn-ghost {
    background: rgba(255,255,255,0.05);
    color: white;
    border: 1px solid rgba(255,255,255,0.15);
    backdrop-filter: blur(10px);
}

.btn-ghost:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.3);
    transform: translateY(-3px);
}

.hero-stats {
    display: flex;
    gap: 48px;
    margin-top: 60px;
    padding-top: 40px;
    border-top: 1px solid var(--borde);
}

.stat h3 {
    font-size: 1.8rem;
    font-weight: 800;
    color: white;
    letter-spacing: -1px;
}

.stat p {
    font-size: 0.8rem;
    color: var(--texto-gris);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
}

/* ===== SECCIONES ===== */
.section {
    padding: 120px 40px;
    position: relative;
}

.section-head {
    max-width: 700px;
    margin: 0 auto 70px;
    text-align: center;
}

.section-tag {
    display: inline-block;
    padding: 5px 14px;
    background: rgba(124,92,255,0.1);
    border: 1px solid rgba(124,92,255,0.25);
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--nova-claro);
    margin-bottom: 20px;
}

.section-head h2 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -1.5px;
    color: white;
    margin-bottom: 16px;
}

.section-head p {
    color: var(--texto-gris);
    font-size: 1.05rem;
}

/* ===== GALERÍA ===== */
.gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    max-width: 1300px;
    margin: 0 auto;
}

.gallery-item {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    cursor: pointer;
    transition: all 0.6s var(--transicion);
    border: 1px solid var(--borde);
    background: var(--bg-card);
}

.gallery-item img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1s var(--transicion);
    filter: brightness(0.85) saturate(1.05);
    display: block;
}

.gallery-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,10,15,0.95) 0%, rgba(10,10,15,0.2) 50%, transparent 100%);
    transition: opacity 0.5s;
    pointer-events: none;
}

.gallery-item:hover {
    transform: translateY(-8px);
    border-color: rgba(124,92,255,0.5);
    box-shadow: 0 25px 50px rgba(124,92,255,0.3);
}

.gallery-item:hover img {
    transform: scale(1.1);
    filter: brightness(1) saturate(1.2);
}

.gallery-meta {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    z-index: 2;
}

.gallery-tag {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(124,92,255,0.9);
    border-radius: 50px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: white;
    margin-bottom: 10px;
}

.gallery-meta h3 {
    font-size: 1.3rem;
    font-weight: 700;
    color: white;
    letter-spacing: -0.5px;
}

.gallery-meta p {
    font-size: 0.85rem;
    color: var(--texto-gris);
    margin-top: 4px;
}

/* ===== SECCIÓN COMPARACIÓN ===== */
.compare-section {
    background: var(--bg-2);
    border-top: 1px solid var(--borde);
    border-bottom: 1px solid var(--borde);
}

.compare-container {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--borde);
    box-shadow: 0 30px 60px rgba(0,0,0,0.5);
    aspect-ratio: 1 / 1;
    background: var(--bg-card);
}

.compare-container > img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
}

.compare-before {
    position: absolute;
    inset: 0;
    clip-path: inset(0 50% 0 0);
    transition: clip-path 0.05s linear;
}

.compare-before img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
}

.compare-divider {
    position: absolute;
    top: 0; bottom: 0;
    left: 50%;
    width: 3px;
    background: var(--nova);
    z-index: 10;
    pointer-events: none;
    box-shadow: 0 0 20px var(--nova);
    transition: left 0.05s linear;
}

.compare-divider::before {
    content: '⇄';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 44px; height: 44px;
    background: var(--nova);
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: white;
    font-size: 18px;
    font-weight: bold;
    box-shadow: 0 0 25px rgba(124,92,255,0.8);
    border: 3px solid var(--bg);
}

.compare-label {
    position: absolute;
    top: 20px;
    padding: 6px 16px;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    z-index: 5;
    backdrop-filter: blur(10px);
}

.compare-label--before {
    left: 20px;
    background: rgba(10,10,15,0.8);
    color: var(--texto-gris);
    border: 1px solid var(--borde);
}

.compare-label--after {
    right: 20px;
    background: rgba(124,92,255,0.9);
    color: white;
}

.compare-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: ew-resize;
    z-index: 20;
}

/* ===== SECCIÓN DESCARGA ===== */
.download-section {
    text-align: center;
    background: 
        radial-gradient(ellipse at 50% 0%, rgba(124,92,255,0.15) 0%, transparent 60%),
        var(--bg);
}

.download-card {
    max-width: 650px;
    margin: 0 auto;
    padding: 60px 40px;
    background: var(--bg-card);
    border-radius: 24px;
    border: 1px solid var(--borde);
    position: relative;
    overflow: hidden;
}

.download-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, transparent, var(--nova), transparent);
}

.download-card h2 {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -1px;
    color: white;
    margin-bottom: 12px;
}

.download-card p {
    color: var(--texto-gris);
    margin-bottom: 32px;
}

.download-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 45px;
    background: linear-gradient(135deg, var(--nova), var(--nova-oscuro));
    color: white;
    text-decoration: none;
    border-radius: 50px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.5px;
    transition: all 0.4s var(--transicion);
    box-shadow: 0 8px 30px rgba(124,92,255,0.4);
    border: none;
    cursor: pointer;
}

.download-btn:hover {
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 15px 45px rgba(124,92,255,0.6);
}

.download-btn svg {
    width: 22px; height: 22px;
    fill: currentColor;
}

.download-info {
    display: flex;
    justify-content: center;
    gap: 30px;
    margin-top: 30px;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: var(--texto-gris);
}

.download-info span {
    display: flex;
    align-items: center;
    gap: 6px;
}

/* ===== FOOTER ===== */
footer {
    padding: 50px 40px 30px;
    border-top: 1px solid var(--borde);
    text-align: center;
    background: var(--bg);
}

footer p {
    color: var(--texto-gris);
    font-size: 0.85rem;
    margin-bottom: 8px;
}

footer a {
    color: var(--nova);
    text-decoration: none;
    transition: color 0.3s;
}

footer a:hover { color: var(--dorado); }

/* ===== ANIMACIONES ===== */
@keyframes fadeUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
}

.fade-in {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s var(--transicion);
}

.fade-in.visible {
    opacity: 1;
    transform: translateY(0);
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .navbar { padding: 14px 20px; }
    .nav-links { display: none; }
    .hero { padding: 100px 20px 60px; }
    .hero-stats { gap: 24px; flex-wrap: wrap; }
    .stat h3 { font-size: 1.4rem; }
    .section { padding: 80px 20px; }
    .download-card { padding: 40px 24px; }
    .brand { font-size: 1.1rem; letter-spacing: 2px; }
    .brand-icon { width: 32px; height: 32px; }
}
</style>
</head>
<body>

